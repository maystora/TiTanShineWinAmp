<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#0D0A1C" android:endColor="@color/vfd_bg" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3D2A6E" />
        </shape>
    </item>
    <!-- thin ambient light line along the bottom edge -->
    <item android:gravity="bottom" android:height="2dp" android:left="24dp" android:right="24dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="0" android:startColor="@color/strip_start" android:centerColor="@color/strip_mid" android:endColor="@color/strip_end" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
