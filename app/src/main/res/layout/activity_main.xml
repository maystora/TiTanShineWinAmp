<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="21sp" />
        <TextView
            android:id="@+id/countText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/ambient_strip" />

    <!-- The glowing display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/vfd_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/timeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:shadowColor="@color/vfd_glow"
                android:shadowRadius="10"
                android:text="0:00"
                android:textColor="@color/vfd"
                android:textSize="40sp" />
            <TextView android:id="@+id/flagPlay" style="@style/Flag" android:text="STOP" />
            <TextView android:id="@+id/flagShuf" style="@style/Flag" android:text="SHUF" />
            <TextView android:id="@+id/flagRep" style="@style/Flag" android:text="REP" />
            <TextView android:id="@+id/flagEq" style="@style/Flag" android:text="EQ" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="marquee"
            android:fontFamily="monospace"
            android:marqueeRepeatLimit="marquee_forever"
            android:shadowColor="@color/vfd_glow"
            android:shadowRadius="8"
            android:singleLine="true"
            android:text="Pick a song to begin"
            android:textColor="@color/vfd"
            android:textSize="18sp" />

        <app.deckline.player.SpectrumView
            android:id="@+id/spectrum"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Visualizer. Tap to change style." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/trackNo" style="@style/Foot" android:layout_width="0dp" android:layout_weight="1" android:text="--/--" />
            <TextView android:id="@+id/vizMode" style="@style/Foot" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="Spectrum" />
            <TextView android:id="@+id/durText" style="@style/Foot" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:text="-:--" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progressTint="@color/play"
        android:thumbTint="@color/play" />

    <!-- Transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal">
        <ImageButton android:id="@+id/prevBtn" style="@style/Key" android:contentDescription="Previous" android:src="@drawable/ic_prev" />
        <ImageButton android:id="@+id/stopBtn" style="@style/Key" android:contentDescription="Stop" android:src="@drawable/ic_stop" />
        <ImageButton
            android:id="@+id/playBtn"
            style="@style/Key"
            android:layout_weight="1.4"
            android:background="@drawable/play_bg"
            android:contentDescription="Play"
            android:src="@drawable/ic_play"
            android:tint="@color/play_ink" />
        <ImageButton android:id="@+id/nextBtn" style="@style/Key" android:contentDescription="Next" android:src="@drawable/ic_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/shuffleChip" style="@style/Chip" android:text="Shuffle" />
        <TextView android:id="@+id/repeatChip" style="@style/Chip" android:text="Repeat: off" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Vol"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
        <SeekBar
            android:id="@+id/volume"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="@color/play"
            android:thumbTint="@color/play" />
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/tabLib" style="@style/Tab" android:text="Library" />
        <TextView android:id="@+id/tabPl" style="@style/Tab" android:text="Playlists" />
        <TextView android:id="@+id/tabEq" style="@style/Tab" android:text="Equalizer" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/edge" />

    <!-- Library panel -->
    <LinearLayout
        android:id="@+id/libPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="10dp">
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/field_bg"
            android:hint="Search songs, artists, albums"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="15sp" />
        <LinearLayout
            android:id="@+id/emptyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/allowBtn"
                style="@style/Chip"
                android:layout_marginTop="14dp"
                android:text="Allow access to music" />
        </LinearLayout>
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:divider="@color/edge"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="true" />
    </LinearLayout>

    <!-- Playlists panel -->
    <LinearLayout
        android:id="@+id/plPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:visibility="gone">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/plActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView
            android:id="@+id/plTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/plSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/plEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="24dp"
            android:textColor="@color/ink_soft"
            android:textSize="15sp"
            android:visibility="gone" />
        <ListView
            android:id="@+id/plList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:divider="@color/edge"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- Equalizer panel -->
    <ScrollView
        android:id="@+id/eqPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/eqContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="20dp" />
    </ScrollView>
</LinearLayout>
